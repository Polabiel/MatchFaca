{
  "name": "matchfaca",
  "private": true,
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=9.6.0"
  },
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "turbo -F @matchfaca/db push",
    "db:studio": "turbo -F @matchfaca/db studio",
    "db:generate": "turbo -F @matchfaca/db postinstall",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @matchfaca/nextjs...",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "test": "tsc -p tsconfig.test.json && node --test .tmp/matchfaca-tests/tests",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add"
  },
  "devDependencies": {
    "@matchfaca/prettier-config": "workspace:*",
    "@turbo/gen": "^2.5.1",
    "prettier": "catalog:",
    "turbo": "^2.5.1",
    "typescript": "catalog:"
  },
  "prettier": "@matchfaca/prettier-config"
}
