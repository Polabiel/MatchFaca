# ─── Database ───────────────────────────────────────────
# Docker: Postgres local (via docker-compose)
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5434"
POSTGRES_USER="matchfaca"
POSTGRES_PASSWORD="matchfaca_dev"
POSTGRES_DB="matchfaca"
POSTGRES_URL="postgres://matchfaca:matchfaca_dev@127.0.0.1:5434/matchfaca?sslmode=disable"

# ─── Auth (NextAuth v5) ─────────────────────────────────
# Generate via: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars-long"

# Preconfigured Discord OAuth provider
# @see https://next-auth.js.org/providers/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Auth Proxy (for Expo OAuth in preview deployments)
# AUTH_REDIRECT_PROXY_URL="https://auth.your-server.com/r"

# ─── Next.js ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT="3000"
# NODE_ENV is not set here — Next.js sets it automatically (dev/prod)
